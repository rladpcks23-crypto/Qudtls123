{
  "name": "neon-harbor",
  "version": "1.1.0",
  "private": true,
  "description": "네온 하버 PC판 (Windows)",
  "author": "Neon Harbor",
  "main": "main.js",
  "scripts": {
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "resedit": "^2.0.2"
  },
  "build": {
    "appId": "kr.yechan.neonharbor.desktop",
    "productName": "Neon Harbor",
    "files": ["main.js", "app/**/*", "icon.png"],
    "directories": { "output": "dist" },
    "afterPack": "./after-pack.js",
    "win": {
      "icon": "icon.ico",
      "target": ["portable"],
      "signAndEditExecutable": false
    },
    "portable": { "artifactName": "NeonHarbor-PC.exe" }
  }
}
