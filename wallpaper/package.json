{
  "name": "study-lock-wallpaper",
  "version": "1.2.0",
  "private": true,
  "description": "공부모드 배경화면 - animated wallpaper that force-closes blocked apps/sites",
  "author": "탕부하나님 레드라인",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "kr.yechan.studylock.wallpaper",
    "productName": "공부모드 배경화면",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "scripts/**/*",
      "build/icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "portable": {
      "artifactName": "공부모드배경화면.exe"
    }
  }
}
