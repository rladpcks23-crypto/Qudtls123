{
  "name": "tangbu-redline",
  "version": "1.2.0",
  "private": true,
  "description": "탕부하나님 레드라인 - Windows desktop build",
  "author": "탕부하나님 레드라인",
  "main": "main.js",
  "scripts": {
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "kr.yechan.tangburedline.desktop",
    "productName": "탕부하나님 레드라인",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["portable"]
    },
    "portable": {
      "artifactName": "탕부하나님레드라인.exe"
    }
  }
}
